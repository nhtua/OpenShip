# Copy to .env in the repository root for Docker Compose.
# Replace the signing secret and storage ID for every installation.

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Model profiles are shared configuration; credential values are environment bindings.
MODEL_PROFILES_JSON='[{"id":"primary","label":"Primary model","adapter":"openai","model":"gpt-4o","endpoint":"https://api.openai.com/v1","api_version":"chat-completions","credential_ref":"OPENAI_API_KEY","capabilities":{"streaming":true,"usage_reporting":true,"context_tokens":8192,"max_output_tokens":4000,"token_counting":false,"tool_calls":false,"structured_output":false,"attachment_types":[],"parallel_tool_calls":false},"allowed_fallback_profile_ids":[],"adapter_options":{"adapter":"openai","output_limit_parameter":"max_tokens"}}]'
MODEL_DEFAULT_PROFILE_ID=primary
MODEL_MAX_TOKENS=4000

# Model provider keys are forwarded to the API and runtime worker as before.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Search tools execute in the runtime worker. Leave both keys empty to use chat only.
# Enable one or both exact tool IDs after configuring their corresponding key.
TOOL_ENABLED_IDS=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# The same named volume and stable identity are used by the API and worker.
# Generate a new UUID per installation and preserve it across upgrades/restores.
ARTIFACT_STORAGE_ID=4d4ee5c7-c013-4d39-8f49-7d0d7d2f635a
ARTIFACT_CONVERSATION_QUOTA_BYTES=134217728
ARTIFACT_CONVERSATION_QUOTA_COUNT=100
ARTIFACT_PROJECT_QUOTA_BYTES=1073741824
ARTIFACT_PROJECT_QUOTA_COUNT=1000

# Host-side ports bind to loopback by default.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080
