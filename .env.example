# OpenShip Environment Configuration

# LLM Configuration
# For local OpenAI-compatible LLM (no API key required)
OPENS_LLM_API_KEY=
OPENS_LLM_BASE_URL=http://127.0.0.1:1212/v1
OPENS_LLM_MODEL=gpt-4
OPENS_LLM_PROVIDER=local

# Cloud Provider (mocked for testing)
OPENS_CLOUD_PROVIDER=aws
OPENS_CLOUD_REGION=us-east-1
OPENS_CLOUD_MOCK=true  # true = run terraform plan only, false = actually apply

# Terraform Configuration
OPENS_TF_BACKEND=local
OPENS_TF_APPLY=false  # Set to true to actually run terraform apply