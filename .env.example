# Copy to .env in the repository root for Docker or Podman Compose.
# Replace the signing secret and storage ID for every installation.
# Optional container CLI for openship-stack Compose commands: docker or podman.
CONTAINER_ENGINE=docker

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Model profiles are shared configuration; credential values are environment bindings.
MODEL_PROFILES_JSON='[
  {
    "id": "primary",
    "label": "OpenAI GPT-6 Luna",
    "adapter": "openai",
    "model": "gpt-6-luna",
    "endpoint": "https://api.openai.com/v1",
    "api_version": "chat-completions",
    "credential_ref": "OPENAI_API_KEY",
    "capabilities": {
      "streaming": true,
      "usage_reporting": true,
      "max_output_tokens": 4000,
      "token_counting": false,
      "tool_calls": true,
      "structured_output": false,
      "attachment_types": [],
      "parallel_tool_calls": false
    },
    "allowed_fallback_profile_ids": [],
    "adapter_options": {
      "adapter": "openai",
      "output_limit_parameter": "max_completion_tokens",
      "tool_call_reasoning_effort": "none"
    }
  }
]'
MODEL_DEFAULT_PROFILE_ID=primary
MODEL_MAX_TOKENS=4000

# Overall run deadline (seconds), including model turns, retries and tools.
WORKFLOW_RUN_TIMEOUT_SECONDS=1800
# Default declared context window (tokens). Smaller provider declarations still apply.
MODEL_CONTEXT_TOKENS=128000
# Independent UTF-8 request-size guard; this is not a tokenizer.
MODEL_MAX_CONTEXT_BYTES=2097152

# Model provider keys are forwarded to the API and runtime worker as before.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Managed tool availability is controlled in Global Settings. Leave the
# optional TOOL_ENABLED_IDS deployment ceiling unset unless you need one.
# These legacy worker bindings remain for persisted v1 runs.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Managed Connector keys live in the ignored ./secrets/ directory and are
# mounted read-only into the API and worker. These IDs are optional until the
# installation is ready to enable managed Connectors.
CONNECTOR_INSTALLATION_ID=
CONNECTOR_OPERATOR_USER_ID=

# The same named volume and stable identity are used by the API and worker.
# Generate a new UUID per installation and preserve it across upgrades/restores.
ARTIFACT_STORAGE_ID=4d4ee5c7-c013-4d39-8f49-7d0d7d2f635a
ARTIFACT_CONVERSATION_QUOTA_BYTES=134217728
ARTIFACT_CONVERSATION_QUOTA_COUNT=100
ARTIFACT_PROJECT_QUOTA_BYTES=1073741824
ARTIFACT_PROJECT_QUOTA_COUNT=1000

# Local dependency ports (used by `-e local up-dependencies`) bind to loopback.
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_NUI_PORT=31311
# The dev stack uses a separate NUI port so local dependencies can stay up.
DEV_NATS_NUI_PORT=31312
# Dev Compose publishes the API and web client on all host interfaces by
# default for LAN access. Set DEV_BIND_ADDRESS=127.0.0.1 for workstation-only.
# PostgreSQL and NATS stay private on the Compose network.
DEV_BIND_ADDRESS=0.0.0.0
API_PORT=8000
WEB_PORT=8080
DEV_WEB_PORT=5173
