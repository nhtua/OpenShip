diff --git a/server/tests/test_capability_profile.py b/server/tests/test_capability_profile.py
new file mode 100644
index 0000000..b7970a9
--- /dev/null
+++ b/server/tests/test_capability_profile.py
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The OpenSandbox Authors
+
+from unittest.mock import patch
+
+from opensandbox_server.config import DockerConfig
+from opensandbox_server.services.docker import DockerSandboxService
+from tests.test_docker_service import _app_config
+
+
+@patch("opensandbox_server.services.docker.docker_service.docker")
+def test_explicit_capability_additions_are_applied_with_drops(mock_docker):
+    mock_docker.from_env.return_value.containers.list.return_value = []
+    config = _app_config()
+    config.docker = DockerConfig(drop_capabilities=["ALL"], add_capabilities=["SETUID", "SETGID"])
+    service = DockerSandboxService(config=config)
+    host_config = service._base_host_config_kwargs(None, None, "bridge")
+    assert host_config["cap_drop"] == ["ALL"]
+    assert host_config["cap_add"] == ["SETUID", "SETGID"]
+    assert "no-new-privileges=true" in host_config["security_opt"]
+
+
+@patch("opensandbox_server.services.docker.docker_service.docker")
+def test_capability_additions_are_absent_by_default(mock_docker):
+    mock_docker.from_env.return_value.containers.list.return_value = []
+    service = DockerSandboxService(config=_app_config())
+    assert "cap_add" not in service._base_host_config_kwargs(None, None, "bridge")
