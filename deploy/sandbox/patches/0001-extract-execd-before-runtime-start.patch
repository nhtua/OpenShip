index 0000000..b293b35
--- /dev/null
+++ b/server/tests/test_execd_created_container.py
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The OpenSandbox Authors
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+from docker.errors import DockerException
+from fastapi import HTTPException
+
+from opensandbox_server.services.docker import DockerSandboxService
+from tests.test_docker_service import _app_config
+
+
+@pytest.mark.parametrize("read_failure", [False, True])
+@patch("opensandbox_server.services.docker.docker_service.docker")
+def test_execd_archive_uses_created_container_and_always_removes_it(mock_docker, read_failure):
+    client = mock_docker.from_env.return_value
+    client.containers.list.return_value = []
+    client.info.return_value = {"OSType": "linux", "Architecture": "amd64"}
+    container = MagicMock()
+    client.containers.create.return_value = container
+    container.start.side_effect = AssertionError("image extraction must not start a runtime")
+
+    def get_archive(path):
+        if read_failure:
+            raise DockerException("archive read failed")
+        return [path.encode()], {}
+
+    container.get_archive.side_effect = get_archive
+    service = DockerSandboxService(config=_app_config())
+    with patch.object(service, "_docker_operation"):
+        if read_failure:
+            with pytest.raises(HTTPException) as error:
+                service._fetch_execd_archive()
+            assert error.value.status_code == 500
+        else:
+            assert service._fetch_execd_archive() == b"/execd"
+            assert service._fetch_execd_archive() == b"/execd"
+            paths = [call.args[0] for call in container.get_archive.call_args_list]
+            assert "/bootstrap.sh" in paths
+            assert "/usr/local/bin/bwrap" in paths
+            assert "/usr/local/libexec/opensandbox-session-gate" in paths
+            assert "/usr/local/libexec/opensandbox-launcher" in paths
+    container.start.assert_not_called()
+    client.containers.create.assert_called_once()
+    container.remove.assert_called_once_with(force=True)
