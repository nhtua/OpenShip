# Copy to .env.prod, chmod 600, and replace every value before starting.
# The stack uses a TLS-enabled private NATS service with file-backed JetStream.

COMPOSE_PROJECT_NAME=openship
# Optional container CLI for openship-stack Compose commands: docker or podman.
CONTAINER_ENGINE=docker
OPENSHIP_API_IMAGE=registry.example.com/openship/api:release
OPENSHIP_WEB_IMAGE=registry.example.com/openship/web:release
POSTGRES_IMAGE=postgres:15
NATS_SERVER_IMAGE=docker.io/library/nats:2.15.1@sha256:023a08c46caa5aff878fb86841187bebfdad9a6e3c552ba5c1a1e18938bbf88a

POSTGRES_DB=openship
POSTGRES_USER=openship
POSTGRES_PASSWORD=
# URL-encode reserved characters in the password so this matches PostgreSQL.
DATABASE_URL=postgresql+psycopg2://openship:URL_ENCODED_PASSWORD@postgres:5432/openship
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# Keep the existing installation's UUID across upgrades and restores.
ARTIFACT_STORAGE_ID=00000000-0000-4000-8000-000000000000
ARTIFACT_CONVERSATION_QUOTA_BYTES=134217728
ARTIFACT_CONVERSATION_QUOTA_COUNT=100
ARTIFACT_PROJECT_QUOTA_BYTES=1073741824
ARTIFACT_PROJECT_QUOTA_COUNT=1000

CONNECTOR_INSTALLATION_ID=
CONNECTOR_OPERATOR_USERNAME=
CONNECTOR_ENCRYPTION_KEY_FILE=/run/secrets/openship-connector-encryption-keys.json
CONNECTOR_IDEMPOTENCY_HMAC_KEY_FILE=/run/secrets/openship-connector-idempotency-hmac-keys.json
CONNECTOR_DISPATCH_LOCK_FILE=/run/secrets/openship-managed-dispatch.lock
CONNECTOR_BROWSER_ORIGINS=https://openship.example.com

MODEL_PROFILES_JSON=[]
MODEL_DEFAULT_PROFILE_ID=
MODEL_MAX_TOKENS=4000
WORKFLOW_RUN_TIMEOUT_SECONDS=1800
MODEL_CONTEXT_TOKENS=128000
MODEL_MAX_CONTEXT_BYTES=2097152
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
TOOL_ENABLED_IDS=

EVENT_RETENTION_DAYS=30
CHECKPOINT_RETENTION_DAYS=30
MESSAGING_RETENTION_DAYS=30
MESSAGING_RETENTION_BATCH_SIZE=1000
LOG_RETENTION_DAYS=7
WEB_PORT=8080

# Do not commit .env.prod. Use immutable application, web and PostgreSQL image
# references published and qualified by your release process.
