# --- Model profiles -------------------------------------------------------------------
#
# Profile configuration is non-secret by contract: a credential is named here
# by the binding it lives in, and its value is read only where a client is
# built. Nothing below can carry a secret into a catalog, an event, a
# checkpoint, or a log line.
#
# Declare profiles as a JSON array. Every field the adapter needs is
# explicit; arbitrary SDK kwargs are not accepted. The example below is
# a starting point: qualify its model capabilities for your deployment and
# put the credential value only in the binding below.

MODEL_PROFILES_JSON='[
  {
    "id": "primary",
    "label": "OpenAI GPT-6 Luna",
    "adapter": "openai",
    "model": "gpt-6-luna",
    "endpoint": "https://api.openai.com/v1",
    "api_version": "chat-completions",
    "credential_ref": "OPENAI_API_KEY",
    "capabilities": {
      "streaming": true,
      "usage_reporting": true,
      "max_output_tokens": 4000,
      "token_counting": false,
      "tool_calls": true,
      "structured_output": false,
      "attachment_types": [],
      "parallel_tool_calls": false
    },
    "allowed_fallback_profile_ids": [],
    "adapter_options": {
      "adapter": "openai",
      "output_limit_parameter": "max_completion_tokens",
      "tool_call_reasoning_effort": "none"
    }
  }
]'

# Which profile answers when the browser chooses nothing. It has to be one of
# the declared profiles; an unknown default is a configuration error.
MODEL_DEFAULT_PROFILE_ID=primary

# The output ceiling a turn asks for, when a profile does not declare its own.
MODEL_MAX_TOKENS=4000

# Overall run deadline (seconds), including model turns, retries and tools.
WORKFLOW_RUN_TIMEOUT_SECONDS=1800
# Default declared context window (tokens). Smaller provider declarations still apply.
MODEL_CONTEXT_TOKENS=128000
# Independent UTF-8 request-size guard; this is not a tokenizer.
MODEL_MAX_CONTEXT_BYTES=2097152

# --- Credential bindings ----------------------------------------------------------------
#
# A profile's `credential_ref` names one of these. Leave the value empty and
# the service still boots: the profile is shown as unavailable, with the
# reason, rather than hidden. One binding per adapter a profile can name -
# declaring a profile whose binding is absent is a configuration gap the
# catalog states, never a silent default.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional deployment ceiling for managed tool availability. Leave this unset
# to let the installation operator manage installed tools in Global Settings.
# Existing deployments can adopt their current allowlist there, then remove the
# variable. An explicit empty value keeps tools chat-only; a nonempty value
# restricts the tools the operator can enable. Environment changes require an
# API and worker restart; ordinary Global Settings changes do not.
# TOOL_ENABLED_IDS=brave_web_search,tavily_web_search
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Stable installation identity and configured global Connector operator.
# Leave blank to keep managed Connector setup/dispatch unavailable.
CONNECTOR_INSTALLATION_ID=
CONNECTOR_OPERATOR_USER_ID=
CONNECTOR_ENCRYPTION_KEY_FILE=/run/secrets/openship-connector-encryption-keys.json
CONNECTOR_IDEMPOTENCY_HMAC_KEY_FILE=/run/secrets/openship-connector-idempotency-hmac-keys.json
# Must include the exact browser origin. The local Vite server uses port 5173.
CONNECTOR_BROWSER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API and worker must share this persistent POSIX root and stable identity.
# Initialize it explicitly with the artifact maintenance CLI.
ARTIFACT_ROOT=var/artifacts
ARTIFACT_STORAGE_ID=4d4ee5c7-c013-4d39-8f49-7d0d7d2f635a
ARTIFACT_CONVERSATION_QUOTA_BYTES=134217728
ARTIFACT_CONVERSATION_QUOTA_COUNT=100
ARTIFACT_PROJECT_QUOTA_BYTES=1073741824
ARTIFACT_PROJECT_QUOTA_COUNT=1000
ARTIFACT_SEARCH_RESERVATION_BYTES=65536
ARTIFACT_CLOUD_OBSERVATION_RESERVATION_BYTES=65536
ARTIFACT_UPLOAD_MAX_BYTES=8388608
ARTIFACT_STAGING_RETENTION_SECONDS=600

# --- Database --------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/openship

# JetStream. Credentials are mounted from a protected role-specific file.
NATS_SERVERS=nats://127.0.0.1:4222
NATS_AUTH_FILE=
NATS_TLS_CA_FILE=

# --- Signing ---------------------------------------------------------------------------

JWT_SECRET=dev-secret-change-in-production-123
JWT_EXPIRY_HOURS=24

# --- Retention -------------------------------------------------------------------------

EVENT_RETENTION_DAYS=30
CHECKPOINT_RETENTION_DAYS=30
MESSAGING_RETENTION_DAYS=30
MESSAGING_RETENTION_BATCH_SIZE=1000
LOG_RETENTION_DAYS=7

# --- Test lanes (not used by the service) -----------------------------------------------
#
# Both name a throwaway database or profile used only to qualify the code.
# Neither is read by the running service.

# The durable-pipeline tests run only against a real PostgreSQL 15 and create
# their own database inside the one named here. Without it they skip.
TEST_POSTGRES_URL=

# The live smoke test contacts a real provider and can incur charges, so it
# runs only when an operator names one installed profile to accept a turn
# against. Without it the test skips; with a profile this installation cannot
# serve, it fails with the reason rather than skipping.
OPENSHIP_LIVE_PROFILE_ID=
