# --- Model profiles -------------------------------------------------------------------
#
# Profile configuration is non-secret by contract: a credential is named here
# by the binding it lives in, and its value is read only where a client is
# built. Nothing below can carry a secret into a catalog, an event, a
# checkpoint, or a log line.
#
# Declare profiles as a JSON array. Every field the adapter needs is
# explicit; arbitrary SDK kwargs are not accepted. The example below is
# redacted - it names no real deployment and no real key.

MODEL_PROFILES_JSON=''

# Which profile answers when the browser chooses nothing. It has to be one of
# the declared profiles; the service refuses to start a default it cannot find.
MODEL_DEFAULT_PROFILE_ID=''

# The output ceiling a turn asks for, when a profile does not declare its own.
MODEL_MAX_TOKENS=4000

# --- Credential bindings ----------------------------------------------------------------
#
# A profile's `credential_ref` names one of these. Leave the value empty and
# the service still boots: the profile is shown as unavailable, with the
# reason, rather than hidden.

OPENAI_API_KEY=

# --- Legacy settings (an installation that declares no profile) -------------------------
#
# These build one synthetic profile so an existing deployment keeps working.
# Once MODEL_PROFILES_JSON is set, they are ignored.

OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Database --------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/openship

# --- Signing ---------------------------------------------------------------------------

JWT_SECRET=dev-secret-change-in-production-123
JWT_EXPIRY_HOURS=24

# --- Retention -------------------------------------------------------------------------

EVENT_RETENTION_DAYS=30
CHECKPOINT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# --- Test lanes (not used by the service) -----------------------------------------------
#
# Both name a throwaway database or profile used only to qualify the code.
# Neither is read by the running service.

# The durable-pipeline tests run only against a real PostgreSQL 15 and create
# their own database inside the one named here. Without it they skip.
TEST_POSTGRES_URL=

# The live smoke test contacts a real provider and can incur charges, so it
# runs only when an operator names one installed profile to accept a turn
# against. Without it the test skips; with a profile this installation cannot
# serve, it fails with the reason rather than skipping.
OPENSHIP_LIVE_PROFILE_ID=
